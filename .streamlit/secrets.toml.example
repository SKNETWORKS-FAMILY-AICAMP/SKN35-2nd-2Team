# TiDB 접속정보 예시.
#
# 쓰는 법
#   1. 이 파일을 같은 폴더에 secrets.toml 로 복사한다
#   2. 아래 값을 TiDB Cloud 콘솔의 Connect 창에서 복사해 채운다
#   3. secrets.toml 은 .gitignore 에 걸려 있으니 절대 커밋되지 않는다
#
# 이 파일(.example)은 값이 비어 있으므로 커밋해도 된다.
# 실제 비밀번호를 여기 적지 말 것.

[tidb]
host     = "gateway01.xxxx.prod.aws.tidbcloud.com"
port     = 4000
user     = "xxxxxxxx.root"
password = ""
database = "steam_churn"

# (선택) 인증서 검증이 실패할 때만 씁니다.
# 평소에는 적지 마세요 — 비워두면 파이썬 certifi 번들을 자동으로 씁니다.
# ca = "C:/Users/tommy/Downloads/ca.pem"
